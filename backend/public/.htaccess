# One domain for the front and the API (same layout as dev-irremplacable):
#   /api/...        -> Symfony (index.php)
#   existing file   -> served as is (compiled React app: index.html, assets/, favicon...)
#   anything else   -> index.html, so React Router handles the URL
DirectoryIndex index.html

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
    Options +SymLinksIfOwnerMatch
    RewriteEngine On

    # Base path, so the rules also work if the app lives in a sub-directory.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    RewriteRule ^api(/|$) %{ENV:BASE}/index.php [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ %{ENV:BASE}/index.html [L]
</IfModule>
