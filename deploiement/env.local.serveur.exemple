# Modèle du fichier de secrets de production, sur le serveur sous le nom
#   <dossier du site>/partage/.env.local
# Ne jamais le commiter ni l'envoyer à qui que ce soit.
# Les clés JWT de production vont à côté, dans <dossier du site>/partage/jwt/ (private.pem, public.pem).

APP_ENV=prod
# 32 caractères au hasard, par exemple : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=a_remplacer

# Base créée dans cPanel (Bases de données MySQL). Sur o2switch, l'hôte est localhost.
# Noms complets, avec le préfixe du compte ajouté par cPanel.
# Dans le mot de passe, les caractères spéciaux autres que les tirets doivent être encodés (%40 pour @…).
DATABASE_URL="mysql://utilisateur_a_remplacer:mot_de_passe_a_remplacer@localhost:3306/base_a_remplacer?serverVersion=11.4.13-MariaDB&charset=utf8mb4"

# Phrase secrète des clés JWT de partage/jwt/.
JWT_PASSPHRASE=a_remplacer

# Application Twitch (console : https://dev.twitch.tv/console), pour l'API IGDB.
IGDB_CLIENT_ID=a_remplacer
IGDB_CLIENT_SECRET=a_remplacer
