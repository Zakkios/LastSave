# Connexion au serveur o2switch, pour npm run deploy.
# Copier ce fichier sous le nom deploiement/config (ignoré par Git), puis le remplir.

# Cible SSH : un alias de ~/.ssh/config, ou identifiant@serveur.o2switch.net
SSH_CIBLE=o2switch-lastsave

# Dossier du site sur le serveur. La racine web du domaine est ce dossier suivi de /courante/public.
DOSSIER_DISTANT=/home/identifiant/lastsave

# Adresse du site, pour le contrôle final.
URL_SITE=https://lastsave.exemple.fr
